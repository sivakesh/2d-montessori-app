# Local-only, non-secret function config for emulator use (loaded by the
# Firebase Functions emulator from functions/.env, which is gitignored).
# Real secrets (none needed yet in Phase 0) must NEVER go in a .env file —
# use `firebase functions:secrets:set` (Secret Manager) instead, per SRS
# NFR-05 and PRD §13 ("No secret keys... in client bundles or public
# documents"). See docs/architecture/environments.md.

SITE_TIMEZONE=Asia/Kolkata
